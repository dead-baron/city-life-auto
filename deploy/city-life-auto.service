# systemd unit for the City Life Auto game server.
# Install: sudo cp deploy/city-life-auto.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now city-life-auto
[Unit]
Description=City Life Auto authoritative game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/city-life-auto
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=2
# SIGTERM -> server saves all profiles before exiting
KillSignal=SIGTERM
TimeoutStopSec=15
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=CLA_DATA_DIR=/home/ubuntu/cla-data
Environment=CLA_ORIGINS=https://deadbaron.com,https://www.deadbaron.com,https://play.deadbaron.com
Environment=CLA_MAX_PLAYERS=120
# The art from the server: bake threads (default 1 on 2 cores; 0 = off) and the qualities baked in the background
# (default 1 = Medium; e.g. 1,2 adds High). See docs/DEPLOY.md.
#Environment=CLA_ART_THREADS=1
#Environment=CLA_ART_PREWARM=1
# After an update (a new build) players come back fresh at a spawn point with their progress (spawn, the
# default); all = everyone also starts over with a brand-new character; off = they carry on where they were.
#Environment=CLA_FRESH_ON_UPDATE=all
# Cost / abuse guards - OFF for now. Monthly data use is always shown in /stats ("traffic").
# To switch on, remove the # in front of these lines, then: sudo systemctl daemon-reload &&
# sudo systemctl restart city-life-auto  (or re-run deploy/setup-oracle.sh)
# Stop sending at 9,000 GB of outbound data a month (Oracle includes 10 TB free) so the bill stays $0:
#Environment=CLA_MONTHLY_GB=9000
# Max simultaneous game connections / new connections a minute / HTTP requests a minute per IP:
#Environment=CLA_MAX_PER_IP=6
#Environment=CLA_CONN_PER_MIN=20
#Environment=CLA_HTTP_PER_MIN=300
# Optional: a fixed secret keeps guest tokens valid if the data dir is ever rebuilt
# Environment=CLA_SECRET=change-me-to-a-long-random-string
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
